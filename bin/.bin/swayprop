#!/usr/bin/env bash

function process_app_info() {
  id=$(echo "$1" | jq -r '.app_id')
  name=$(echo "$1" | jq -r '.name')
  if [[ "$name" == "null" ]]; then
    echo "name was empty"
  else
    echo "NAME=$name"
    echo "NAME=$name" | wl-copy
  fi
  if [[ "$id" == "null" ]]; then
    class=$(echo "$1" | jq -r '.window_properties.class')
    echo "CLASS=$class"
    echo "CLASS=$class" | wl-copy

  else
    echo "ID=$id"
    echo "ID=$id" | wl-copy
  fi
  notify-send.sh "App info was copied to clipboard!"
}

function prop() {
  # Needs to be declared before it’s assigned or I cannot grab the exit code
  # later. Fun race condition <.<
  local selection
  local window
  # Find all visible windows and get their geometry, then
  # format slurp-friendly, then
  # run slurp!
  selection=$(swaymsg -t get_tree | jq '.. | select(.visible?==true) | .rect | [ .x,.y,.width,.height ]' |
    jq -r '"\(.[0]),\(.[1]) \(.[2])x\(.[3])"' |
    slurp -r)

  local ret=$?
  [ $ret -ne 0 ] && exit $ret

  local x=$(echo "$selection" | awk -F'[, x]' '{print $1}')
  local y=$(echo "$selection" | awk -F'[, x]' '{print $2}')
  local w=$(echo "$selection" | awk -F'[, x]' '{print $3}')
  local h=$(echo "$selection" | awk -F'[, x]' '{print $4}')
  # Find the window matching the selection.
  window=$(swaymsg -t get_tree |
    jq ".. | select((.rect?.x==$x) and (.rect?.y==$y) and (.rect?.width==$w) and (.rect?.height=$h) and (.visible?==true))")

  [ -z "$window" ] && exit 1

  # Check if id was passed an if so only echo class, id and name
  # Also copy it to clipboard instead of just printing it.
  if [[ "$1" == "id" ]]; then
    process_app_info "$window"
  else
    # Pretty print, since capturing the output of `swaymsg` makes it uglify.
    echo $window | jq
  fi
}

function check_dependencies() {
  local ret=0
  for cmd in "$@"; do
    ! [ $(command -v $cmd) ] && echo "Missing dependency: $cmd." && ret=1
  done
  return $ret
}

(check_dependencies "jq" "slurp" "swaymsg" "wl-copy") || exit 1

prop "$1"

#!/usr/bin/env bash

function process_app_info() {
  # No niri, usamos app_id (Wayland) e window_class (XWayland)
  id=$(echo "$1" | jq -r '.app_id // .window_class')
  title=$(echo "$1" | jq -r '.title')

  if [[ "$title" == "null" ]]; then
    echo "Title was empty"
  else
    echo "TITLE=$title"
    echo "$title" | wl-copy
  fi

  if [[ "$id" != "null" ]]; then
    echo "ID/CLASS=$id"
    echo "$id" | wl-copy
  fi

  notify-send "App info was copied to clipboard!"
}

function prop() {
  local selection
  local window

  # Pega geometria das janelas focadas/visíveis via niri msg
  selection=$(niri msg -j windows | jq -r '.[] | "\(.geometry.x),\(.geometry.y) \(.geometry.width)x\(.geometry.height)"' | slurp -r)

  local ret=$?
  [ $ret -ne 0 ] && exit $ret

  # Extrai coordenadas da seleção do slurp
  local x=$(echo "$selection" | awk -F'[, x]' '{print $1}')
  local y=$(echo "$selection" | awk -F'[, x]' '{print $2}')
  local w=$(echo "$selection" | awk -F'[, x]' '{print $3}')
  local h=$(echo "$selection" | awk -F'[, x]' '{print $4}')

  # Localiza a janela que bate com a geometria selecionada
  window=$(niri msg -j windows | jq ".[] | select(.geometry.x==$x and .geometry.y==$y and .geometry.width==$w and .geometry.height==$h)")

  [ -z "$window" ] && exit 1

  if [[ "$1" == "id" ]]; then
    process_app_info "$window"
  else
    echo "$window" | jq
  fi
}

function check_dependencies() {
  local ret=0
  for cmd in "$@"; do
    ! command -v "$cmd" >/dev/null 2>&1 && echo "Missing dependency: $cmd." && ret=1
  done
  return $ret
}

check_dependencies "jq" "slurp" "niri" "wl-copy" || exit 1

prop "$1"
